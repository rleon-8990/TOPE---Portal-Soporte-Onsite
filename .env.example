# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MICROSOFT 365 / DATAVERSE / SHAREPOINT CONFIGURATION:
# Configurable via the in-app "SharePoint / Dataverse" connector modal or environment variables.
VITE_M365_DATAVERSE_URL=""
VITE_M365_TENANT_ID=""
VITE_M365_CLIENT_ID=""
VITE_M365_SHAREPOINT_SITE_URL=""
VITE_M365_WEBHOOK_URL=""

